{
	"nodes":[
		{"id":"7q7f8a9b0c1d2e3f","type":"group","x":-488,"y":750,"width":380,"height":450,"color":"5","label":"Phase 6: Visual Branding"},
		{"id":"0t0c1d2e3f4a5b6c","type":"group","x":-88,"y":750,"width":380,"height":450,"color":"4","label":"Phase 7: Website Design"},
		{"id":"3w3f4a5b6c7d8e9f","type":"group","x":312,"y":750,"width":380,"height":450,"color":"3","label":"Phase 8: Viral Content"},
